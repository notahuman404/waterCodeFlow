{
  "name": "watercodeflow",
  "displayName": "WaterCodeFlow",
  "description": "Time-travel debugger for Python",
  "version": "0.2.0",
  "publisher": "watercodeflow",
  "engines": { "vscode": "^1.89.0" },
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "watercodeflow-sidebar",
          "title": "WaterCodeFlow",
          "icon": "media/icon.svg"
        }
      ],
      "panel": [
        {
          "id": "watercodeflow-panel",
          "title": "Recording Viewer",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "watercodeflow-sidebar": [
        {
          "type": "webview",
          "id": "watercodeflow.variables",
          "name": "Variables"
        }
      ],
      "watercodeflow-panel": [
        {
          "type": "webview",
          "id": "watercodeflow.recordingViewer",
          "name": "Recording Viewer"
        }
      ]
    },
    "commands": [
      { "command": "watercodeflow.openVariables",    "title": "Variables",          "icon": "$(eye)" },
      { "command": "watercodeflow.openSettings",     "title": "Watcher Settings",   "icon": "$(gear)" },
      { "command": "watercodeflow.openFileSelector", "title": "Select Files",       "icon": "$(device-camera-video)" },
      { "command": "watercodeflow.openRecordings",   "title": "Recordings",         "icon": "$(record)" },
      { "command": "watercodeflow.openInsights",     "title": "Insights",           "icon": "$(graph)" },
      { "command": "watercodeflow.openInspector",    "title": "Variable Inspector", "icon": "$(search)" },
      { "command": "watercodeflow.openRunInspector", "title": "Run Inspector",      "icon": "$(list-ordered)" },
      { "command": "watercodeflow.runFile",          "title": "Run File",           "icon": "$(play)" }
    ],
    "menus": {
      "editor/title": [
        { "command": "watercodeflow.openVariables",    "group": "navigation@1", "when": "true" },
        { "command": "watercodeflow.openSettings",     "group": "navigation@2", "when": "true" },
        { "command": "watercodeflow.openFileSelector", "group": "navigation@3", "when": "true" },
        { "command": "watercodeflow.openRecordings",   "group": "navigation@4", "when": "true" },
        { "command": "watercodeflow.runFile",          "group": "navigation@5", "when": "true" }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "esbuild": "tsc -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.89.0",
    "@types/node": "20.x",
    "typescript": "^5.3.3"
  }
}
